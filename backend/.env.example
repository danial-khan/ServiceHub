# Server port (default: 9000)
PORT=9000

# Path to frontend build/modules directory
# Default: ../frontend/build/modules
MODULES_DIR=../frontend/build/modules

# Public base URL for module URLs in catalog.json
# Leave empty for relative URLs (good for Vercel)
# Set to your deployment URL for absolute URLs
# Example: https://servicehub-backend.vercel.app
PUBLIC_BASE_URL=
