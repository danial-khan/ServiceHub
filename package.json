{
  "name": "servicehub-monorepo",
  "version": "1.0.0",
  "description": "ServiceHub React Native on-demand module delivery demo - monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "frontend/packages/*",
    "backend"
  ],
  "scripts": {
    "app": "npm run start --workspace=frontend",
    "android": "npm run android --workspace=frontend",
    "ios": "npm run ios --workspace=frontend",
    "build:modules": "npm run build:modules --workspace=frontend",
    "publish:modules": "node scripts/publish-all.js",
    "backend": "npm run dev --workspace=backend",
    "test": "npm run test --workspace=frontend",
    "typecheck": "npm run typecheck --workspace=frontend && npm run typecheck --workspace=backend"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
