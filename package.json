{
  "name": "ServiceHub",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "webpack-cli serve --config webpack.config.mjs",
    "start:shell": "PLATFORM=android webpack-cli serve --config webpack.config.mjs --port 8081",
    "start:doctor": "PLATFORM=android webpack-cli serve --config webpack.doctor.config.mjs --port 9001",
    "start:barber": "PLATFORM=android webpack-cli serve --config webpack.barber.config.mjs --port 9002",
    "start:food": "PLATFORM=android webpack-cli serve --config webpack.food.config.mjs --port 9003",
    "build": "npm run build:shell && npm run build:modules",
    "build:shell": "PLATFORM=android webpack-cli --config webpack.config.mjs --mode production",
    "build:modules": "npm run build:doctor && npm run build:barber && npm run build:food",
    "build:doctor": "node scripts/build-module.js doctor",
    "build:barber": "node scripts/build-module.js barber",
    "build:food": "node scripts/build-module.js food",
    "build:all-modules": "node scripts/build-all.js",
    "publish:all": "node scripts/publish-all.js",
    "publish:doctor": "npm run build:doctor && node scripts/publish-module.js doctor",
    "publish:barber": "npm run build:barber && node scripts/publish-module.js barber",
    "publish:food": "npm run build:food && node scripts/publish-module.js food",
    "host": "cd module-host && npm start",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@callstack/repack": "^5.4.0",
    "@module-federation/enhanced": "^2.9.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/asset-utils": "^0.87.1",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "js-sha256": "^1.0.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.28.0",
    "react-native-vector-icons": "^10.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-loader": "^10.1.1",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
